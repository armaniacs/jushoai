# `npx wxt submit`（publish-extension）のローカル確認用テンプレート。
# 複写して `.env.submit` にし、値を埋めて使う。`.env.submit` は git 管理外。
# cp .env.submit.example .env.submit
#
# 手順: make zip && make zip-firefox && npx wxt submit --dry-run
# （--dry-run は認証のみ確認し、zip を送らない）

CHROME_API_VERSION=v2
CHROME_EXTENSION_ID=
CHROME_PUBLISHER_ID=
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=
CHROME_ZIP=dist/jushoai-0.1.17-chrome.zip

EDGE_PRODUCT_ID=
EDGE_CLIENT_ID=
EDGE_API_KEY=
EDGE_ZIP=dist/jushoai-0.1.17-chrome.zip

FIREFOX_CHANNEL=listed
FIREFOX_EXTENSION_ID=jushoai@armaniacs.github.io
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
FIREFOX_ZIP=dist/jushoai-0.1.17-firefox.zip
FIREFOX_SOURCES_ZIP=dist/jushoai-0.1.17-sources.zip
