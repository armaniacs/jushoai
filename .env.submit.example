# `npx wxt submit`（publish-extension）のローカル確認用テンプレート。
# 複写して `.env.submit` にし、値を埋めて使う。`.env.submit` は git 管理外。
# cp .env.submit.example .env.submit
#
# 手順: make zip && make zip-firefox && npx wxt submit --dry-run
# （--dry-run は認証のみ確認し、zip を送らない）

CHROME_API_VERSION=v1.1
CHROME_EXTENSION_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=
CHROME_ZIP=dist/jushoai-0.1.16-chrome.zip

EDGE_PRODUCT_ID=
EDGE_CLIENT_ID=
EDGE_API_KEY=
EDGE_ZIP=dist/jushoai-0.1.16-chrome.zip

FIREFOX_CHANNEL=listed
FIREFOX_EXTENSION_ID=jushoai@armaniacs.github.io
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
FIREFOX_ZIP=dist/jushoai-0.1.16-firefox.zip
FIREFOX_SOURCES_ZIP=dist/jushoai-0.1.16-sources.zip
