{
  "name": "jushoai",
  "private": true,
  "version": "0.1.12",
  "description": "Japanese form filler: names, furigana and split addresses",
  "license": "GPL-3.0-only",
  "author": "armaniacs",
  "homepage": "https://armaniacs.github.io/jushoai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armaniacs/jushoai.git"
  },
  "bugs": {
    "url": "https://github.com/armaniacs/jushoai/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "lint:firefox": "web-ext lint --source-dir dist/firefox-mv3",
    "test:build": "vitest run -c vitest.build.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "site": "node site/build.ts && node site/check.ts",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "@types/selenium-webdriver": "^4.35.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "markdown-it": "^15.0.2",
    "selenium-webdriver": "^4.50.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
